  def argument_owner=(_); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
  def checked_variable_types; end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
  def checked_variable_types=(_); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
  def list_depth; end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
  def list_depth=(_); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
  def path; end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
  def path=(_); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
  def variable_name; end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
  def variable_name=(_); end

  class << self
    # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
    def [](*_arg0); end

    # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
    def inspect; end

    # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
    def keyword_init?; end

    # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
    def members; end

    # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
    def new(*_arg0); end
  end
end

