  # - `Boolean` — `true` if GraphQL-Ruby is currently eager-loading its constants
  #
  # :call-seq:
  #   eager_loading?() -> bool
  #
  # pkg:gem/graphql#lib/graphql/autoload.rb:60
  def eager_loading?; end
end

