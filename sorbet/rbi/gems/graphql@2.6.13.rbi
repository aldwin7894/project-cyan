module GraphQL::StaticValidation::FieldsWillMerge
  requires_ancestor { GraphQL::StaticValidation::BaseVisitor }
  requires_ancestor { GraphQL::StaticValidation::BaseVisitor::ContextMethods }

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:58
  def initialize(*); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:94
