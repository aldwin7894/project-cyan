#       # handle it specially ...
#     else
#       super
#      end
#   end
# end
# ```
#
# **Example: disabling debug annotations completely**
#
# ```ruby
# use DetailedTrace, debug: false, ...
# ```
#
# **Example: disabling debug annotations for one query**
#
# ```ruby
# MySchema.execute(query_str, context: { detailed_trace_debug: false })
# ```
#
