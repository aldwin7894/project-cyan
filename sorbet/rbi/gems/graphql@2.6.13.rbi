  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:89
  def on_operation_definition(node, _parent); end

  private

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:187
  sig do
    params(
      response_key: T.untyped,
      node1: ::GraphQL::Language::Nodes::Field,
      node2: ::GraphQL::Language::Nodes::Field,
      different_names: T::Boolean,
      different_arguments: T::Boolean,
      message_override: T.nilable(::String)
    ).void
  end
  def add_field_conflict(response_key, node1, node2, different_names, different_arguments, message_override); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:180
  sig { params(node1: ::GraphQL::Language::Nodes::Field, node2: ::GraphQL::Language::Nodes::Field).void }
  def add_legacy_conflict_nodes(node1, node2); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:145
  sig do
    params(
      response_key: T.untyped,
      node1: ::GraphQL::Language::Nodes::Field,
      node2: ::GraphQL::Language::Nodes::Field,
      different_names: T::Boolean,
      different_arguments: T::Boolean,
      type1: T.untyped,
      type2: T.untyped
    ).void
  end
  def add_legacy_invalid_conflict(response_key, node1, node2, different_names, different_arguments, type1, type2); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:522
  sig do
    params(
      response_key: T.untyped,
      t1: T.untyped,
      t2: T.untyped,
      node1: ::GraphQL::Language::Nodes::Field,
      node2: ::GraphQL::Language::Nodes::Field
    ).void
  end
  def add_return_type_conflict(response_key, t1, t2, node1, node2); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:613
  def cached_sub_fields(node, return_type); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:104
  sig { params(node: T.untyped, parent_type: T.untyped).void }
  def check_selection_set(node, parent_type); end

  # Collect all fields from selections, expanding fragment spreads inline.
  # Returns a Hash of { response_key => Field | [Field, ...] }
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:266
  def collect_fields(selections, owner_type:, parents:); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:272
  def collect_fields_inner(selections, owner_type:, parents:, response_keys:, visited_fragments:); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:243
  def conflicts; end

  # Core algorithm: collect ALL fields (expanding fragments inline) into a flat
  # map keyed by response key, then compare within each group.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:253
  def conflicts_within_selection_set(node, parent_type); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:671
  def field_group_signature(fields); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:649
  def field_groups_already_compared?(fields, fields2, mutually_exclusive); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:440
  def field_selection_signature(field); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:455
  def field_signature(field); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:445
  def fields_same_signature?(f1, f2); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:467
  def find_conflict(response_key, field1, field2, mutually_exclusive: T.unsafe(nil)); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:627
  def find_conflicts_between(response_keys, response_keys2, mutually_exclusive:); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:422
  def find_conflicts_between_selection_groups(response_key, fields); end

  # When two fields with the same response key both have sub-selections,
  # we need to check those sub-selections against each other.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:583
  def find_conflicts_between_sub_selection_sets(field1, field2, mutually_exclusive:); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:331
  def find_conflicts_within(response_keys); end

  # Previous versions compared only the first field of each group of fields with the same signature,
  # and one field for each sub-selection in a group. For the spec check, that's the same as comparing each field,
  # unless the fields in a group have different parent types or sub-selections. Then the spec check can find more conflicts.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:390
  sig { params(response_key: T.untyped, fields: T::Array[::GraphQL::StaticValidation::FieldsWillMerge::Field]).void }
  def legacy_find_conflicts_within(response_key, fields); end

  # Previous versions compared the lists of type conditions above each field, position by position,
  # and treated lists with different lengths as mutually exclusive.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:729
  sig { params(parents1: T::Array[T.untyped], parents2: T::Array[T.untyped]).returns(T::Boolean) }
  def legacy_mutually_exclusive?(parents1, parents2); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:713
  sig do
    params(
      field1: ::GraphQL::StaticValidation::FieldsWillMerge::Field,
      field2: ::GraphQL::StaticValidation::FieldsWillMerge::Field
    ).returns(T::Boolean)
  end
  def mutually_exclusive?(field1, field2); end

  # SameResponseShape in the spec. Compare one wrapper at a time: `list?` is also true for a non-null list.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:567
  sig { params(type1: T.untyped, type2: T.untyped).returns(T::Boolean) }
  def return_types_conflict?(type1, type2); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:679
  def same_arguments?(field1, field2); end

  # Quick check: can the direct children of this selection set possibly conflict?
  # If all direct selections are Fields with unique names and no aliases,
  # and there are no fragments, then no response key can have >1 field,
  # so there are no merge conflicts to check at this level.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:209
  def selections_may_conflict?(selections); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:693
  def serialize_arg(arg_value); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:704
  def serialize_field_args(field); end

  # As in the spec (FieldsInSetCanMerge), only fields on different object types are mutually exclusive,
  # even if no runtime object can be selected by both of them.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:720
  sig do
    params(
      field1: ::GraphQL::StaticValidation::FieldsWillMerge::Field,
      field2: ::GraphQL::StaticValidation::FieldsWillMerge::Field
    ).returns(T::Boolean)
  end
  def spec_mutually_exclusive?(field1, field2); end

  # Use the spec rule for mutually exclusive fields, with its own caches, and record conflicts in `@spec_conflicts`
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/fields_will_merge.rb:131
  sig { params(block: T.proc.void).void }
  def with_spec_check(&block); end
end

