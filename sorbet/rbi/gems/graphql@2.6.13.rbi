# [AbstractNode](rdoc-ref:GraphQL::Language::Nodes::AbstractNode) is the base class for all nodes in a GraphQL AST.
#
# It provides some APIs for working with ASTs:
# - `children` returns all AST nodes attached to this one. Used for tree traversal.
# - `scalars` returns all scalar (Ruby) values attached to this one. Used for comparing nodes.
# - `to_query_string` turns an AST node into a GraphQL string
#
# pkg:gem/graphql#lib/graphql/language/nodes.rb:13
class GraphQL::Language::Nodes::AbstractNode
  # Value equality
  #
  # **Returns**
  #
  # - `Boolean` — True if `self` is equivalent to `other`
  #
  # :call-seq:
  #   ==(other) -> bool
  #
  # pkg:gem/graphql#lib/graphql/language/nodes.rb:65
  def ==(other); end

  # **Returns**
  #
  # - `Array<GraphQL::Language::Nodes::AbstractNode>` — all nodes in the tree below this one
  #
  # :call-seq:
  #   children() -> Array[GraphQL::Language::Nodes::AbstractNode]
  #
  # pkg:gem/graphql#lib/graphql/language/nodes.rb:81
  sig { returns(T::Array[::GraphQL::Language::Nodes::AbstractNode]) }
  def children; end

  # pkg:gem/graphql#lib/graphql/language/nodes.rb:103
  def children_method_name; end

  # pkg:gem/graphql#lib/graphql/language/nodes.rb:48
  sig { returns(T.nilable(::Integer)) }
  def col; end

  # pkg:gem/graphql#lib/graphql/language/nodes.rb:53
  sig { returns(T.nilable(::Integer)) }
  def definition_line; end

  # TODO DRY with `replace_child`
  #
  # pkg:gem/graphql#lib/graphql/language/nodes.rb:176
  def delete_child(previous_child); end

  # pkg:gem/graphql#lib/graphql/language/nodes.rb:40
  sig { returns(T.nilable(::String)) }
  def filename; end

  # pkg:gem/graphql#lib/graphql/language/nodes.rb:43
  sig { returns(T.nilable(::Integer)) }
  def line; end

  # This creates a copy of `self`, with `new_options` applied.
  #
  # **Parameters**
  #
  # - `new_options` (`Hash`)
  #
  # **Returns**
  #
  # - `AbstractNode` — a shallow copy of `self`
  #
  # :call-seq:
  #   merge(Hash new_options) -> AbstractNode
  #
