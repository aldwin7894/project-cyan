  def name; end

  # **Returns**
  #
  # - `String` — An opaque string which identifies this event, derived from `name` and `arguments`
  #
  # pkg:gem/graphql#lib/graphql/subscriptions/event.rb:28
  def topic; end

  class << self
    # pkg:gem/graphql#lib/graphql/subscriptions/event.rb:83
