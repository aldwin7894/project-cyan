  # pkg:gem/graphql#lib/graphql/execution/interpreter/arguments.rb:75
  def inspect; end

  # pkg:gem/graphql#lib/graphql/execution/interpreter/arguments.rb:72
  def key?(*, **, &); end

  # pkg:gem/graphql#lib/graphql/execution/interpreter/arguments.rb:72
