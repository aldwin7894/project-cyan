  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:15
  def initialize(*); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:76
  def on_argument(node, parent); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:40
  def on_document(node, parent); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:34
  def on_fragment_definition(node, parent); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:28
  def on_operation_definition(node, parent); end

  private

  # Add the error which previous versions added for this usage, if any, so that the legacy behavior rejects the same documents.
  # They didn't check variables in nested lists, used the depth of the whole list value for each variable in it,
  # and treated a `= null` default as non-null.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:232
  sig do
    params(
      argument_owner: T.untyped,
      arg_node: ::GraphQL::Language::Nodes::Argument,
      ast_var: ::GraphQL::Language::Nodes::VariableDefinition,
      list_depth: ::Integer
    ).void
  end
  def add_legacy_error(argument_owner, arg_node, ast_var, list_depth); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:262
  sig do
    params(
      error_message: ::String,
      var_type: T.untyped,
      ast_var: ::GraphQL::Language::Nodes::VariableDefinition,
      arg_defn: T.untyped,
      arg_node: ::GraphQL::Language::Nodes::Argument,
      path: T.nilable(T::Array[::String]),
      message_override: T.nilable(::String)
    ).void
  end
  def create_error(error_message, var_type, ast_var, arg_defn, arg_node, path, message_override); end

  # The maximum depth of list literals in `value`
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:248
  sig { params(value: T.untyped).returns(::Integer) }
  def depth_of_array(value); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:292
  def list_dimension(type); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:302
  def non_null_levels_match(arg_type, var_type); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:205
  sig { params(arg_defn: T.untyped, var_type: T.untyped, list_depth: ::Integer).returns(T.nilable(::String)) }
  def usage_error(arg_defn, var_type, list_depth); end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:149
  sig { params(ast_var: ::GraphQL::Language::Nodes::VariableDefinition, legacy: T::Boolean).returns(T.untyped) }
  def usage_variable_type(ast_var, legacy: T.unsafe(nil)); end

  # `legacy_reported:` is true when the legacy check has the same result, so an error isn't a legacy invalid usage.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:167
  sig do
    params(
      argument_owner: T.untyped,
      arg_node: ::GraphQL::Language::Nodes::Argument,
      ast_var: ::GraphQL::Language::Nodes::VariableDefinition,
      list_depth: ::Integer,
      path: T.nilable(T::Array[::String]),
      var_type: T.untyped,
      legacy_reported: T::Boolean
    ).void
  end
  def validate_usage(argument_owner, arg_node, ast_var, list_depth, path: T.unsafe(nil), var_type: T.unsafe(nil), legacy_reported: T.unsafe(nil)); end

  # Variables inside input objects are found when their own arguments are visited.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:138
  sig do
    params(
      value: T.untyped,
      list_depth: ::Integer,
      variables: T.nilable(T::Array[[::GraphQL::Language::Nodes::VariableIdentifier, ::Integer]])
    ).returns(T.nilable(T::Array[[::GraphQL::Language::Nodes::VariableIdentifier, ::Integer]]))
  end
  def variables_in_value(value, list_depth, variables); end

  # A variable in list literals is used as a list item, so wrap its type in one list for each list literal.
  #
  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:283
  sig { params(var_type: T.untyped, list_depth: ::Integer).returns(T.untyped) }
  def wrap_var_type_in_lists(var_type, list_depth); end
end

# A variable in a fragment. It's checked after the visit, against each operation which uses the fragment.
# `list_depth` is the number of list literals around the variable.
#
# pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
class GraphQL::StaticValidation::VariableUsagesAreAllowed::FragmentVariableUsage < ::Struct
  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
  def arg_node; end

  # pkg:gem/graphql#lib/graphql/static_validation/rules/variable_usages_are_allowed.rb:13
  def arg_node=(_); end

