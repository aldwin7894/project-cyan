  # - `Class` — The class to initialize when adding fields to this kind of schema member
  #
  # :call-seq:
  #   field_class(new_field_class) -> Class
  #
  # pkg:gem/graphql#lib/graphql/schema/member/has_fields.rb:180
  def field_class(new_field_class = T.unsafe(nil)); end

  # pkg:gem/graphql#lib/graphql/schema/member/has_fields.rb:190
  def global_id_field(field_name, **kwargs); end

  # **Parameters**
  #
  # - `new_has_no_fields` (`Boolean`) — Call with `true` to make this Object type ignore the requirement to have any defined fields.
  #
  # **Returns**
