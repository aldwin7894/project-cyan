  # - `String` — a logical identifier for this event. (Stable when the query is broadcastable.)
  #
  # :call-seq:
  #   fingerprint() -> String
  #
  # pkg:gem/graphql#lib/graphql/subscriptions/event.rb:67
  def fingerprint; end

  # **Returns**
