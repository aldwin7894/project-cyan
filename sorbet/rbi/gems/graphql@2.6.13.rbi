    # pkg:gem/graphql#lib/graphql/subscriptions/event.rb:98
    def deep_sort_hash_keys(hash_to_sort); end

    # pkg:gem/graphql#lib/graphql/subscriptions/event.rb:169
    def get_arg_definition(arg_owner, arg_name, context); end

    # pkg:gem/graphql#lib/graphql/subscriptions/event.rb:124
