    # Override this method in your app's subclass of this directive.
    #
    # **Parameters**
    #
    # - `flag_name` (`String`) — The client-provided string of a feature to check
    # - `object` (`GraphQL::Schema::Objct`) — The currently-evaluated GraphQL object instance
    # - `context` (`GraphQL::Query::Context`)
    #
    # **Returns**
    #
    # - `Boolean` — If truthy, execution will continue
    #
    # :call-seq:
    #   enabled?(String flag_name, GraphQL::Schema::Objct object, GraphQL::Query::Context context) -> bool
    #
    # pkg:gem/graphql#lib/graphql/schema/directive/feature.rb:77
    def enabled?(flag_name, object, context); end

    # Implement the Directive API
    #
    # pkg:gem/graphql#lib/graphql/schema/directive/feature.rb:58
    def include?(object, arguments, context); end

    # pkg:gem/graphql#lib/graphql/schema/directive/feature.rb:81
    def resolve_field(*, **, &); end

    # pkg:gem/graphql#lib/graphql/schema/directive/feature.rb:82
