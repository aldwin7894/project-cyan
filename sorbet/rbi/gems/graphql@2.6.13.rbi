# ```ruby
# # enum PizzaTopping {
# #   MUSHROOMS
# #   ONIONS
# #   PEPPERS
# # }
# class PizzaTopping < GraphQL::Schema::Enum
#   value :MUSHROOMS
#   value :ONIONS
#   value :PEPPERS
# end
# ```
